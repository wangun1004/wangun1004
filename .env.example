# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube OAuth2 (for upload)
YOUTUBE_CLIENT_ID=your_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
# After first login, token is saved to youtube_token.json

# Anthropic Claude (script generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (DALL-E image generation)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs TTS (optional — falls back to gTTS if not set)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Output settings
OUTPUT_DIR=output
VIDEO_RESOLUTION=1920x1080
VIDEO_FPS=30
TARGET_DURATION=600   # seconds (10 minutes)
LANGUAGE=ko           # ko=Korean, en=English
